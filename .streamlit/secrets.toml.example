# Streamlit Cloud secrets — add your keys here when deploying
# These map to environment variables automatically

GEMINI_API_KEY = "your_gemini_api_key_here"
GOOGLE_API_KEY = "your_gemini_api_key_here"
USE_MOCK_LLM = "false"
LLM_MODEL = "gemini-2.0-flash"
EMBEDDING_MODEL = "all-MiniLM-L6-v2"
DEBATE_ROUNDS = "2"
